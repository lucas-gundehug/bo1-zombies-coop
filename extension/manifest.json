{
  "manifest_version": 3,
  "name": "BO1 Zombies Co-op + Cheats for vel.gg",
  "short_name": "BO1 Zombies Co-op",
  "version": "2.2.2.4",
  "description": "Play Black Ops 1 Zombies in the browser (vel.gg) with up to 4 players: direct co-op, a cheat menu (M), an in-game map (N) and controller support.",
  "homepage_url": "https://github.com/lucas-gundehug/bo1-zombies-coop#readme",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://vel.gg/*"
      ],
      "js": [
        "coop.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    }
  ]
}
